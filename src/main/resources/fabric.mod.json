{
	"schemaVersion": 1,
	"id": "tunnelvision",
	"version": "${version}",
	"name": "TunnelVision",
	"description": "",
	"authors": [
		"TunnelVisionMod"
	],
	"contact": {
		"homepage": "https://github.com/TunnelVisionMod/TunnelVision",
		"sources": "https://github.com/TunnelVisionMod/TunnelVision",
		"issues": "https://github.com/TunnelVisionMod/TunnelVision/issues"
	},
	"license": "MIT",
	"icon": "assets/tunnelvision/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"adapter": "kotlin",
				"value": "io.github.tunnelvisionmod.tunnelvision.TunnelVision"
			}
		],
		"modmenu": [
			{
				"adapter": "kotlin",
				"value": "io.github.tunnelvisionmod.tunnelvision.core.config.ModMenuIntegration"
			}
		]
	},
	"mixins": [
		"tunnelvision.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
		"hypixel-mod-api": ">=1.0.2"
	}
}
